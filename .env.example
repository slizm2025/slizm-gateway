# 复制为 .env 后填入真实凭据。.env 绝不提交到 Git。
# providers.json 里用 "env:NAME" 引用这里的变量。

ANTHROPIC_KEY=
ANY_KEY=
DEEPSEEK_KEY=
GEMINI_KEY=
OPENAI_KEY=
RELAY_KEY=

# 网关自身监听配置（可选）
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=4000
GATEWAY_LOG_REQUESTS=1

# 远程服务器（dedi）部署常用选项（可选）
# GATEWAY_CLIENT_TOKEN=
# GATEWAY_REQUIRE_STRONG_TOKEN=1
# GATEWAY_SHUTDOWN_TIMEOUT_MS=60000
# GATEWAY_USAGE_DIR=./logs
# TZ=Asia/Shanghai
