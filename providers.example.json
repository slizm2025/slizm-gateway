{
  "clientToken": "sk-local-gateway-change-me",

  "defaultRoute": "relay",

  "providers": [
    {
      "name": "relay",
      "apiType": "anthropic",
      "baseUrl": "https://api.shuaiapi.com",
      "apiKey": "env:RELAY_KEY",
      "authStyle": "auto",
      "models": {}
    },
    {
      "name": "claude",
      "apiType": "anthropic",
      "baseUrl": "https://api.anthropic.com",
      "apiKey": "env:ANTHROPIC_KEY",
      "authStyle": "x-api-key",
      "models": {}
    },
    {
      "name": "deepseek",
      "apiType": "anthropic",
      "baseUrl": "https://api.deepseek.com/anthropic",
      "apiKey": "env:DEEPSEEK_KEY",
      "authStyle": "bearer",
      "models": {}
    },
    {
      "name": "gemini",
      "apiType": "gemini",
      "baseUrl": "https://generativelanguage.googleapis.com",
      "apiKey": "env:GEMINI_KEY",
      "authStyle": "bearer",
      "models": {}
    }
  ],

  "routes": {
    "opus": { "provider": "claude", "model": "claude-opus-5-5" },
    "sonnet": { "provider": "deepseek", "model": "deepseek-chat" },
    "haiku": { "provider": "gemini", "model": "gemini-2.5-flash" },

    "plan": { "provider": "claude", "model": "claude-opus-5-5" },
    "exec": { "provider": "deepseek", "model": "deepseek-chat" },
    "scout": { "provider": "gemini", "model": "gemini-2.5-flash" }
  },

  "pricing": {
    "claude-opus-5-5": { "input": 4, "cacheRead": 0.2, "cacheWrite": 5, "output": 20 },
    "claude-sonnet-5": { "input": 2, "cacheRead": 0.2, "cacheWrite": 2.5, "output": 10 },
    "claude-haiku-4-5": { "input": 1, "cacheRead": 0.1, "cacheWrite": 1.25, "output": 5 },
    "gpt-6-sol": { "input": 1, "cacheRead": 0.1, "cacheWrite": 1.25, "output": 5 },
    "gpt-6-astra": { "input": 5, "cacheRead": 0.5, "cacheWrite": 6.25, "output": 25 },
    "gemini-3.8-flash": { "input": 0.75, "cacheRead": 0.075, "cacheWrite": 0, "output": 3.75 },
    "gemini-2.5-flash": { "input": 0.3, "cacheRead": 0.03, "cacheWrite": 0, "output": 2.5 },
    "deepseek-chat": { "input": 0.27, "cacheRead": 0.014, "cacheWrite": 0.27, "output": 1.1 },
    "deepseek-flash": { "input": 0.3, "cacheRead": 0.006, "cacheWrite": 0.3, "output": 1.2 },
    "deepseek-v4.1-flash-0910": { "input": 0.3, "cacheRead": 0.006, "cacheWrite": 0.3, "output": 1.2 }
  }
}
